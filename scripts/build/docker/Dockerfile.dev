# syntax=docker/dockerfile:1

# =============================================================================
# vLLM DSV4 SM89 (cu130) 开发镜像
#
# 用途：在 Ubuntu 22.04 宿主机上用 Docker 开发本仓库（容器默认 Ubuntu 24.04）。
#   - 构建工具链：gcc/build-essential、cmake、ninja、ccache、rust、protoc
#   - Python 3.12 + uv venv：torch(cu130)、vLLM 构建/运行依赖、lint 工具
#   - GPU：基于 nvidia/cuda:<CUDA_VERSION>-devel-ubuntu<UBUNTU_VERSION>，
#     容器运行时通过 --gpus all + NVIDIA Container Toolkit 访问宿主机 GPU
#
# 与官方 docker/Dockerfile 的差异：
#   - 基础镜像默认 Ubuntu 24.04（可用 UBUNTU_VERSION 覆盖）
#   - 默认 TORCH_VERSION=2.13.0，与 scripts/build/cu130_install_deps.sh 一致
#   - 默认 TORCH_CUDA_ARCH_LIST=8.9+PTX，面向 Ada (SM 8.9)
#   - 源码不进镜像，通过 bind mount 挂载，改动即时生效
#
# 构建入口：scripts/build/docker/build_dev_image.sh
# =============================================================================
ARG CUDA_VERSION=13.0.3
ARG UBUNTU_VERSION=24.04
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ARG CUDA_VERSION
ARG UBUNTU_VERSION
ARG PYTHON_VERSION=3.12
ARG TORCH_VERSION=2.13.0
ARG VLLM_MAIN_CUDA_VERSION=13.0
ARG TORCH_CUDA_ARCH_LIST=8.9+PTX
ARG PROTOC_VERSION=34.2
ARG UV_DEFAULT_INDEX=https://pypi.org/simple
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
ARG UV_PYTHON_INSTALL_MIRROR=
ARG RUSTUP_DIST_SERVER=
ARG PROTOC_GH_MIRROR=
ARG INSTALL_TEST_DEPS=0

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_LINK_MODE=copy
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY=unsafe-best-match
ENV UV_INSTALL_DIR=/opt/uv/bin
ENV UV_CACHE_DIR=/opt/uv/cache
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
ENV VIRTUAL_ENV=/opt/venv
ENV CARGO_HOME=/opt/cargo
ENV RUSTUP_HOME=/opt/rustup
ENV CUDA_HOME=/usr/local/cuda
ENV CONDA_PREFIX=/opt/venv
ENV VLLM_MAIN_CUDA_VERSION=${VLLM_MAIN_CUDA_VERSION}
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
ENV VLLM_ENABLE_CUDA_COMPATIBILITY=0
ENV HF_HOME=/home/dev/.cache/huggingface
ENV VLLM_CACHE_ROOT=/home/dev/.cache/vllm
ENV TRITON_CACHE_DIR=/home/dev/.cache/triton
ENV CCACHE_DIR=/home/dev/.cache/ccache
ENV PATH=/opt/venv/bin:/opt/uv/bin:/opt/cargo/bin:/usr/local/cuda/bin:${PATH}

# RUN 里用了 bash 语法（[[ ]]），显式切到 bash
SHELL ["/bin/bash", "-c"]

RUN apt-get update -y && apt-get install -y --no-install-recommends \
        build-essential \
        ccache \
        cmake \
        ninja-build \
        pkg-config \
        curl \
        ca-certificates \
        gnupg \
        git \
        unzip \
        libibverbs-dev \
        libnuma-dev \
        python3-dev \
        python3-venv \
        openssh-client \
        rsync \
        gdb \
        strace \
        jq \
        ripgrep \
        htop \
        tmux \
        vim \
        zsh \
        iproute2 \
        iputils-ping \
        dnsutils \
    && rm -rf /var/lib/apt/lists/*

# uv + Python 3.12 虚拟环境（uv 会自动下载托管 Python）
RUN mkdir -p "${UV_INSTALL_DIR}" "${UV_CACHE_DIR}" "${UV_PYTHON_INSTALL_DIR}" \
    && if [[ -n "${UV_PYTHON_INSTALL_MIRROR}" ]]; then \
         export UV_PYTHON_INSTALL_MIRROR="${UV_PYTHON_INSTALL_MIRROR}"; \
       fi \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && uv venv --seed /opt/venv --python "${PYTHON_VERSION}" \
    && uv --version \
    && /opt/venv/bin/python --version

# PyTorch (cu130)：只从 PyTorch 官方/镜像索引安装，保证 wheel 是 +cu130 构建
RUN uv pip install --python /opt/venv/bin/python \
        --index-url "${TORCH_INDEX_URL}" \
        "torch==${TORCH_VERSION}"

# vLLM 构建依赖：剔除 requirements 里 torch 系的硬 pin，换回本镜像的 TORCH_VERSION
COPY requirements/build/cuda.txt /tmp/vllm-reqs/build-cuda.txt
RUN sed -E '/^(torch|torchaudio|torchvision|torchcodec)([[:space:]]*[<>=]|$)/d' \
        /tmp/vllm-reqs/build-cuda.txt > /tmp/vllm-reqs/build-cuda-filtered.txt \
    && printf 'torch==%s\n' "${TORCH_VERSION}" >> /tmp/vllm-reqs/build-cuda-filtered.txt \
    && uv pip install --python /opt/venv/bin/python \
        --index-url "${UV_DEFAULT_INDEX}" \
        --extra-index-url "${TORCH_INDEX_URL}" \
        -r /tmp/vllm-reqs/build-cuda-filtered.txt

# vLLM 运行依赖（FlashInfer、tilelang、cutlass-dsl、quack 等），同样保留 TORCH_VERSION
COPY requirements/common.txt requirements/cuda.txt /tmp/vllm-reqs/
RUN sed -E '/^(torch|torchaudio|torchvision|torchcodec)([[:space:]]*[<>=]|$)/d' \
        /tmp/vllm-reqs/cuda.txt > /tmp/vllm-reqs/runtime.txt \
    && printf 'torch==%s\n' "${TORCH_VERSION}" >> /tmp/vllm-reqs/runtime.txt \
    && uv pip install --python /opt/venv/bin/python \
        --index-url "${UV_DEFAULT_INDEX}" \
        --extra-index-url "${TORCH_INDEX_URL}" \
        -r /tmp/vllm-reqs/runtime.txt

# lint 工具（pre-commit 等，vLLM 贡献规范要求）
COPY requirements/lint.txt /tmp/vllm-reqs/lint.txt
RUN uv pip install --python /opt/venv/bin/python \
        --index-url "${UV_DEFAULT_INDEX}" \
        -r /tmp/vllm-reqs/lint.txt

# Rust 工具链：版本取自仓库 rust-toolchain.toml（build_rust.sh 也会兜底安装）
COPY rust-toolchain.toml /tmp/vllm-reqs/rust-toolchain.toml
RUN RUST_CHANNEL="$(grep -E '^[[:space:]]*channel' /tmp/vllm-reqs/rust-toolchain.toml | sed -E 's/.*"([^"]+)".*/\1/')" \
    && if [[ -n "${RUSTUP_DIST_SERVER}" ]]; then \
         export RUSTUP_DIST_SERVER="${RUSTUP_DIST_SERVER}" \
                RUSTUP_UPDATE_ROOT="${RUSTUP_DIST_SERVER%/}/rustup"; \
       fi \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
         sh -s -- -y --profile minimal --default-toolchain "${RUST_CHANNEL}" \
    && rustup component add --toolchain "${RUST_CHANNEL}" rustfmt clippy \
    && rustup toolchain list

# protoc（Rust 前端构建需要）
COPY tools/install_protoc.sh /tmp/vllm-reqs/install_protoc.sh
RUN if [[ -n "${PROTOC_GH_MIRROR}" ]]; then \
        sed -i "s#https://github.com/#${PROTOC_GH_MIRROR}#" /tmp/vllm-reqs/install_protoc.sh; \
    fi \
    && PROTOC_VERSION="${PROTOC_VERSION}" bash /tmp/vllm-reqs/install_protoc.sh \
    && protoc --version

# 可选：把 pytest 等完整测试依赖打进镜像（INSTALL_TEST_DEPS=1）。默认不进，
# 之后在容器里跑 vllm-install-test-deps 即可，两者都会保留所选 torch 版本。
COPY requirements /tmp/vllm-reqs/requirements
RUN if [[ "${INSTALL_TEST_DEPS}" == "1" ]]; then \
        sed -E '/^(torch|torchaudio|torchvision|torchcodec)([[:space:]]*[<>=]|$)/d' \
            /tmp/vllm-reqs/requirements/test/cuda.txt > /tmp/vllm-reqs/requirements/test/cuda.txt.new \
        && mv /tmp/vllm-reqs/requirements/test/cuda.txt.new /tmp/vllm-reqs/requirements/test/cuda.txt \
        && uv pip install --python /opt/venv/bin/python \
            --index-url "${UV_DEFAULT_INDEX}" \
            --extra-index-url "${TORCH_INDEX_URL}" \
            -r /tmp/vllm-reqs/requirements/dev.txt; \
    fi

# 容器辅助脚本 + 交互 shell 配置
COPY scripts/build/docker/entrypoint.sh /usr/local/bin/vllm-dev-entrypoint
COPY scripts/build/docker/install_test_deps.sh /usr/local/bin/vllm-install-test-deps
RUN chmod +x /usr/local/bin/vllm-dev-entrypoint /usr/local/bin/vllm-install-test-deps \
    && mkdir -p /home/dev/.cache/huggingface \
               /home/dev/.cache/vllm \
               /home/dev/.cache/triton \
               /home/dev/.cache/ccache \
    && cat > /etc/profile.d/vllm-dev.sh <<'EOF'
# vLLM 开发容器：登录 shell 的补充配置（默认环境变量已写在镜像 ENV 里）
if [[ -z "${HF_HOME:-}" ]]; then export HF_HOME=/home/dev/.cache/huggingface; fi
if [[ -z "${VLLM_CACHE_ROOT:-}" ]]; then export VLLM_CACHE_ROOT=/home/dev/.cache/vllm; fi
if [[ -z "${TRITON_CACHE_DIR:-}" ]]; then export TRITON_CACHE_DIR=/home/dev/.cache/triton; fi
if [[ -z "${CCACHE_DIR:-}" ]]; then export CCACHE_DIR=/home/dev/.cache/ccache; fi
git config --global --add safe.directory /workspace/vllm 2>/dev/null || true
EOF

WORKDIR /workspace/vllm
ENTRYPOINT ["/usr/local/bin/vllm-dev-entrypoint"]
CMD ["bash", "-l"]
