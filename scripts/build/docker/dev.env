# vLLM DSV4 SM89 (cu130) Docker 开发环境配置
#
# 该文件被 build_dev_image.sh / run_dev.sh 读取。所有值都支持被同名环境变量覆盖：
#   export TORCH_VERSION=2.13.0
#   bash scripts/build/docker/build_dev_image.sh

# ---- 镜像构建参数 ----
CUDA_VERSION="${CUDA_VERSION:-13.0.3}"
UBUNTU_VERSION="${UBUNTU_VERSION:-24.04}"
PYTHON_VERSION="${PYTHON_VERSION:-3.12}"
# 与 scripts/build/cu130_install_deps.sh 保持一致（默认跟随仓库 requirements
# 的 pin：2.13.0；如想改用其他版本，设 TORCH_VERSION 后重新构建镜像）
TORCH_VERSION="${TORCH_VERSION:-2.13.0}"
TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-8.9+PTX}"
VLLM_MAIN_CUDA_VERSION="${VLLM_MAIN_CUDA_VERSION:-13.0}"
PROTOC_VERSION="${PROTOC_VERSION:-34.2}"
IMAGE_TAG="${IMAGE_TAG:-vllm-dsv4-dev:cu130-ubuntu24.04-sm89}"
# 1 = 构建镜像时把 pytest 等完整测试依赖也打进镜像（默认不进，之后可随时在容器内
# 执行 vllm-install-test-deps 补装）
INSTALL_TEST_DEPS="${INSTALL_TEST_DEPS:-0}"

# ---- 网络 / 镜像源 ----
# 1 = 国内源（阿里云 PyTorch + 清华 PyPI）
USE_CN_MIRROR="${USE_CN_MIRROR:-0}"
# 留空时 build_dev_image.sh 会根据 CUDA_VERSION 自动推导
TORCH_INDEX_URL="${TORCH_INDEX_URL:-}"
UV_DEFAULT_INDEX="${UV_DEFAULT_INDEX:-}"
# 可选：uv 托管 Python / rustup / protoc 的国内加速
UV_PYTHON_INSTALL_MIRROR="${UV_PYTHON_INSTALL_MIRROR:-}"
RUSTUP_DIST_SERVER="${RUSTUP_DIST_SERVER:-}"
PROTOC_GH_MIRROR="${PROTOC_GH_MIRROR:-}"

# ---- 容器运行参数 ----
CONTAINER_NAME="${CONTAINER_NAME:-vllm-dsv4-dev}"
WORKDIR_MOUNT="${WORKDIR_MOUNT:-/workspace/vllm}"
DEPS_VOLUME="${DEPS_VOLUME:-vllm-dsv4-deps}"
UV_VOLUME="${UV_VOLUME:-vllm-dsv4-uv}"
HOME_VOLUME="${HOME_VOLUME:-vllm-dsv4-home}"
VLLM_PORT="${VLLM_PORT:-8000}"
SHM_SIZE="${SHM_SIZE:-8g}"
# 1 = 把宿主机 ~/.ssh 只读挂进容器（方便 git push / 拉私有模型）
MOUNT_SSH="${MOUNT_SSH:-1}"
VLLM_ENABLE_CUDA_COMPATIBILITY="${VLLM_ENABLE_CUDA_COMPATIBILITY:-0}"
